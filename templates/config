# pen user config. One "key = value" per line, split at the first "=";
# comments go on their own lines. Keys here apply to every project. A project's
# .pen/config takes the same format but only "allow" and "github_owner" (no
# tokens or env, since it's usually committed). Changes apply to the next session.
# Keep this file private (mode 600): it holds secrets.

# --- GitHub (read-only) --------------------------------------------------------
# One fine-grained, read-only PAT per owner (your account or an org):
# Contents and Metadata read (optionally Issues and Pull requests read). Pick
# "Only select repositories" if you can. The owner comes from the project's
# origin URL, or from github_owner in its .pen/config.
#
# github.<owner> = github_pat_…

# --- Agent environment -----------------------------------------------------------
# Passed to the agent container only, by name (never on a command line).
#
# env.ANTHROPIC_API_KEY = sk-ant-…
# env.OPENAI_API_KEY = sk-…
#
# Skip Claude's per-project login: run `claude setup-token` once, anywhere, and
# paste the token here. It's long-lived, so treat it like an API key.
# env.CLAUDE_CODE_OAUTH_TOKEN = …

# --- Network -----------------------------------------------------------------------
# Extra allowed domains for every project, one per line. A leading dot also
# allows its subdomains. `pen allow --global <domain>` adds lines here.
#
# allow = example.com
# allow = .example.org
