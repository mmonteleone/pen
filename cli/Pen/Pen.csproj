<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pen</AssemblyName>
    <RootNamespace>Pen</RootNamespace>
    <Version>0.1.0</Version>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Code style (.editorconfig) and XML doc comments are checked in the build; members needn't all have docs. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- The XML file is only for those checks: a Native AOT publish has nothing to copy it from. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- TOML config parsing; source-generated metadata only (see TomlContext), so AOT-safe. -->
    <PackageReference Include="Tomlyn" Version="2.10.2" />
  </ItemGroup>

  <!-- Everything the CLI needs at runtime is embedded, so it never reads this
       repo once installed. Logical names are repo-relative paths. -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)compose.yaml" LogicalName="compose.yaml" />
    <EmbeddedResource Include="$(RepoRoot)image/**/*" LogicalName="image/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(RepoRoot)proxy/**/*" LogicalName="proxy/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(RepoRoot)templates/**/*" LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Dot files such as .DS_Store would be errors: a recipe is exactly its two files. -->
    <EmbeddedResource Include="$(RepoRoot)tools/**/*" Exclude="$(RepoRoot)tools/**/.*" LogicalName="tools/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
