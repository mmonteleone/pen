root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all

[*.{csproj,props,targets,slnx}]
indent_size = 2

[{*.json,*.jsonc,*.toml,*.yaml,*.yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.py]
indent_size = 4

[*.sh]
indent_size = 2

[Dockerfile]
indent_size = 2

[Makefile]
indent_style = tab

[*.{gitignore,conf}]
indent_size = 2
